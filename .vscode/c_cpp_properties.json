{
    "version": 4,
    "configurations": [
        {
            "name": "Windows (MSYS2 UCRT64)",
            "includePath": [
                "${workspaceFolder}/core",
                "${workspaceFolder}/src",
                "C:/msys64/ucrt64/include/**"
            ],
            "defines": [
                "_DEBUG",
                "UNICODE",
                "_UNICODE",
                "TAL_PLATFORM_WIN=1"
            ],
            "compilerPath": "C:/msys64/ucrt64/bin/gcc.exe",
            "cStandard": "c11",
            "cppStandard": "c++17",
            "intelliSenseMode": "windows-gcc-x64"
        },
        {
            "name": "macOS (Apple Silicon / Intel)",
            "includePath": [
                "${workspaceFolder}/core",
                "${workspaceFolder}/src",
                "/opt/homebrew/include/**",
                "/usr/local/include/**"
            ],
            "defines": [
                "_DEBUG",
                "TAL_PLATFORM_MAC=1"
            ],
            "compilerPath": "/usr/bin/clang",
            "cStandard": "c11",
            "cppStandard": "c++17",
            "intelliSenseMode": "macos-clang-arm64"
        },
        {
            "name": "Linux (GCC)",
            "includePath": [
                "${workspaceFolder}/core",
                "${workspaceFolder}/src",
                "/usr/include/**"
            ],
            "defines": [
                "_DEBUG",
                "TAL_PLATFORM_LINUX=1"
            ],
            "compilerPath": "/usr/bin/gcc",
            "cStandard": "c11",
            "cppStandard": "c++17",
            "intelliSenseMode": "linux-gcc-x64"
        }
    ]
}
