{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug TinyAudioLab",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/tinyaudiolab_app",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": true,
            "preLaunchTask": "Build TinyAudioLab",
            "windows": {
                "program": "${workspaceFolder}/build/tinyaudiolab_app.exe",
                "MIMode": "gdb",
                "miDebuggerPath": "C:/msys64/ucrt64/bin/gdb.exe",
                "setupCommands": [
                    {
                        "description": "Enable pretty-printing for gdb",
                        "text": "-enable-pretty-printing",
                        "ignoreFailures": true
                    }
                ]
            },
            "osx": {
                "program": "${workspaceFolder}/build/tinyaudiolab_app",
                "MIMode": "lldb"
            },
            "linux": {
                "program": "${workspaceFolder}/build/tinyaudiolab_app",
                "MIMode": "gdb",
                "miDebuggerPath": "/usr/bin/gdb",
                "setupCommands": [
                    {
                        "description": "Enable pretty-printing for gdb",
                        "text": "-enable-pretty-printing",
                        "ignoreFailures": true
                    }
                ]
            }
        }
    ]
}
